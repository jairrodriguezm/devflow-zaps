# Server Configuration
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:4200

# Database
MONGODB_URI=mongodb://localhost:27017/devflow

# GitHub OAuth App (Must request scopes: read:user, repo, admin:repo_hook)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback

# GitHub Webhooks
# Public URL exposed via ngrok or smee.io (e.g. https://smee.io/xyz or https://xyz.ngrok-free.app)
WEBHOOK_BASE_URL=http://localhost:3000/api/webhooks/github
GITHUB_WEBHOOK_SECRET=super_secret_webhook_signature

# Auth & Session Security
JWT_SECRET=devflow_jwt_secret_production_ready_key_12345

# AI Copilot (Bonus)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini