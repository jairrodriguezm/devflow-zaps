{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "paths": {
      "@shared": ["./node_modules/@devflow/shared/zap.types.ts"],
      "@shared/*": ["./node_modules/@devflow/shared/*"]
    }
  },
  "include": ["src/**/*"]
}
